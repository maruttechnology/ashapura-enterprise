---

<section id="industries" class="py-20 md:py-[120px] px-6 md:px-14 lg:px-[80px] bg-[oklch(0.99_0.003_95)] overflow-hidden">
  <div class="max-w-[1280px] mx-auto">
    
    <!-- Section Title -->
    <div class="max-w-[640px] mb-[48px]">
      <span class="text-[13px] font-bold tracking-[2px] uppercase text-[oklch(0.52_0.07_240)] mb-[16px] block">INDUSTRIES WE SERVE</span>
      <h2 class="font-display font-bold text-3xl sm:text-4xl md:text-[44px] tracking-[-1px] text-[oklch(0.22_0.03_250)]">
        Supplying the sectors that build the world
      </h2>
    </div>

    <!-- Desktop Version: Expanding Bento Row with Industrial Photos & Glassmorphic Badges -->
    <div class="hidden md:flex h-[540px] gap-3 w-full select-none overflow-hidden rounded-[24px]">
      {industries.map((ind, index) => (
        <div 
          class={`industry-panel transition-all duration-600 ease-[cubic-bezier(0.22,1,0.36,1)] relative border border-white/20 rounded-[24px] overflow-hidden cursor-pointer group ${index === 0 ? 'flex-[3.2] active' : 'flex-1'}`}
          data-index={index}
        >
          <!-- Industrial Background Photo with Smooth Hover Zoom -->
          <img 
            src={ind.image} 
            alt={ind.name} 
            class="absolute inset-0 w-full h-full object-cover group-[.active]:scale-105 transition-transform duration-700"
          />

          <!-- Dark Gradient Vignette Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-[oklch(0.14_0.02_250)]/95 via-[oklch(0.14_0.02_250)]/60 to-[oklch(0.14_0.02_250)]/30"></div>
          
          <!-- Stripe Overlay Texture -->
          <div class="absolute inset-0 bg-[repeating-linear-gradient(135deg,rgba(255,255,255,0.04)_0px,rgba(255,255,255,0.04)_16px,transparent_16px,transparent_32px)] opacity-50"></div>

          <!-- Upper Row: Sector Number & Glassmorphic Icon Badge -->
          <div class="absolute top-7 left-7 right-7 flex justify-between items-center z-20">
            <span class="font-display font-bold text-sm tracking-wider text-[oklch(0.7_0.17_40)] bg-black/40 backdrop-blur-md px-3 py-1 rounded-full border border-white/10">
              {ind.number}
            </span>

            <!-- Glassmorphic Icon Badge -->
            <div class="w-11 h-11 rounded-full bg-white/20 backdrop-blur-md text-white border border-white/30 flex items-center justify-center transition-all duration-300 group-[.active]:bg-[oklch(0.62_0.19_35)] group-[.active]:border-[oklch(0.62_0.19_35)] shadow-md">
              <Fragment set:html={ind.icon} />
            </div>
          </div>

          <!-- Vertical Title (Collapsed State) -->
          <div class="industry-vertical-name absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 select-none pointer-events-none transition-opacity duration-400 group-[.active]:opacity-0 z-20">
            <h3 class="font-display font-bold text-xl text-white/90 tracking-tight whitespace-nowrap" style="writing-mode: vertical-rl; transform: rotate(180deg);">
              {ind.name}
            </h3>
          </div>

          <!-- Active Panel Details (Expanded State) -->
          <div class="absolute left-7 right-7 bottom-7 z-20 industry-content transition-all duration-500 transform translate-y-2 opacity-0 group-[.active]:translate-y-0 group-[.active]:opacity-100">
            <div class="flex items-center gap-2 mb-2">
              <div class="w-6 h-[2px] bg-[oklch(0.62_0.19_35)]"></div>
              <span class="text-xs uppercase tracking-widest text-[oklch(0.7_0.17_40)] font-bold">SECTOR</span>
            </div>
            <h3 class="font-display font-bold text-2xl lg:text-3xl text-white mb-3 tracking-tight">
              {ind.name}
            </h3>
            <p class="text-sm text-white/80 leading-relaxed max-w-[300px]">
              {ind.description}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Mobile Version: Touch Swipeable Card Slider -->
    <div class="flex md:hidden gap-4 overflow-x-auto snap-x snap-mandatory scrollbar-none py-2 px-1 touch-pan-x">
      {industries.map((ind) => (
        <div class="snap-start flex-none w-[280px] h-[360px] rounded-[20px] overflow-hidden relative border border-white/20 shadow-lg flex flex-col justify-between p-6 group">
          <!-- Background Photo -->
          <img src={ind.image} alt={ind.name} class="absolute inset-0 w-full h-full object-cover" />
          <!-- Dark Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-[oklch(0.14_0.02_250)]/95 via-[oklch(0.14_0.02_250)]/70 to-[oklch(0.14_0.02_250)]/40"></div>

          <!-- Top Row -->
          <div class="relative z-10 flex justify-between items-center">
            <span class="font-display font-bold text-xs text-[oklch(0.7_0.17_40)] bg-black/40 backdrop-blur-md px-3 py-1 rounded-full border border-white/10">
              {ind.number}
            </span>
            <div class="w-10 h-10 rounded-full bg-[oklch(0.62_0.19_35)] text-white flex items-center justify-center shadow-md">
              <Fragment set:html={ind.icon} />
            </div>
          </div>

          <!-- Bottom Details -->
          <div class="relative z-10">
            <h3 class="font-display font-bold text-2xl text-white mb-2">{ind.name}</h3>
            <p class="text-xs text-white/80 leading-relaxed">{ind.description}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  function initIndustries() {
    const panels = document.querySelectorAll('.industry-panel');
    if (panels.length === 0) return;

    panels.forEach((panel) => {
      panel.addEventListener('mouseenter', () => {
        // Reset all panels
        panels.forEach((p) => {
          p.classList.remove('flex-[3.2]', 'active');
          p.classList.add('flex-1');
        });

        // Expand active panel
        panel.classList.remove('flex-1');
        panel.classList.add('flex-[3.2]', 'active');
      });
    });
  }

  document.addEventListener('astro:page-load', initIndustries);
</script>

