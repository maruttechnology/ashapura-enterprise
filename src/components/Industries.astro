---
const industries = [
  {
    number: "01",
    name: "Construction",
    description: "High-rise buildings, residential complexes, commercial developments, and structural frames.",
    icon: "construction"
  },
  {
    number: "02",
    name: "Infrastructure",
    description: "Bridges, flyovers, metro rail projects, arterial highways, and public utility structures.",
    icon: "infrastructure"
  },
  {
    number: "03",
    name: "Engineering",
    description: "Heavy machinery bases, industrial plant equipment, transmission towers, and brackets.",
    icon: "engineering"
  },
  {
    number: "04",
    name: "Fabrication",
    description: "Custom steel fabrication workshops, industrial enclosures, steel gates, and job works.",
    icon: "fabrication"
  },
  {
    number: "05",
    name: "Manufacturing",
    description: "Industrial manufacturing plants, original equipment manufacturers (OEMs), and components.",
    icon: "manufacturing"
  }
];
---

<section id="industries" class="py-24 px-6 md:px-14 max-w-7xl mx-auto w-full border-b border-border-hairline">
  <div class="mb-14">
    <span class="text-xs font-bold tracking-[0.25em] uppercase text-accent-gold mb-4 block">INDUSTRIES WE SERVE</span>
    <h2 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight max-w-xl">
      Supporting critical sectors with premium steel
    </h2>
  </div>

  <!-- Desktop Version: Expanding Flex Row -->
  <div class="hidden md:flex h-[520px] gap-4 w-full select-none overflow-hidden">
    {industries.map((ind, index) => (
      <div 
        class={`industry-panel transition-all duration-550 ease-[cubic-bezier(0.22,1,0.36,1)] relative border border-border-hairline overflow-hidden p-8 flex flex-col justify-between group ${index === 0 ? 'flex-[3.2] active bg-panel-bg' : 'flex-1 bg-panel-bg/25'}`}
        data-index={index}
      >
        <!-- Background Overlay Image Placeholder -->
        <div class="absolute inset-0 bg-[repeating-linear-gradient(45deg,oklch(0.26_0.014_30)_0px,oklch(0.26_0.014_30)_8px,transparent_8px,transparent_16px)] opacity-10 group-hover:opacity-20 transition-opacity pointer-events-none"></div>

        <!-- Upper Row: Number & Icon/Tag -->
        <div class="relative z-10 flex justify-between items-start">
          <span class="font-display font-bold text-sm text-accent-gold">{ind.number}</span>
          
          <!-- Icon placeholder (Visible in active state) -->
          <div class="industry-icon w-10 h-10 rounded-full bg-accent-vermillion/10 flex items-center justify-center text-accent-vermillion transition-all duration-300 opacity-0 scale-90 group-[.active]:opacity-100 group-[.active]:scale-100">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
          </div>
        </div>

        <!-- Middle: Vertical Name (Visible in collapsed state) -->
        <div class="industry-vertical-name absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 origin-center select-none pointer-events-none transition-all duration-400 group-[.active]:opacity-0 group-[.active]:pointer-events-none">
          <h3 class="font-display font-bold text-lg text-text-muted tracking-widest whitespace-nowrap" style="writing-mode: vertical-rl; transform: rotate(180deg);">
            {ind.name}
          </h3>
        </div>

        <!-- Lower Panel: Title & Description (Revealed in active state) -->
        <div class="relative z-10 industry-content transition-all duration-500 transform translate-y-4 opacity-0 group-[.active]:translate-y-0 group-[.active]:opacity-100 pointer-events-none group-[.active]:pointer-events-auto">
          <h3 class="font-display font-bold text-3xl text-text-primary mb-3">
            {ind.name}
          </h3>
          <p class="text-sm text-text-muted leading-relaxed max-w-md">
            {ind.description}
          </p>
        </div>
      </div>
    ))}
  </div>

  <!-- Mobile Version: Clean Stacking Cards -->
  <div class="flex md:hidden flex-col gap-4">
    {industries.map((ind) => (
      <div class="bg-panel-bg border border-border-hairline p-6 flex flex-col gap-3">
        <div class="flex items-center justify-between border-b border-border-hairline pb-3">
          <span class="font-display font-bold text-xs text-accent-gold">{ind.number}</span>
          <h3 class="font-display font-bold text-xl text-text-primary">{ind.name}</h3>
        </div>
        <p class="text-xs text-text-muted leading-relaxed">
          {ind.description}
        </p>
      </div>
    ))}
  </div>
</section>

<script>
  function initIndustries() {
    const panels = document.querySelectorAll('.industry-panel');
    if (panels.length === 0) return;

    panels.forEach((panel) => {
      panel.addEventListener('mouseenter', () => {
        // Reset all panels to collapsed states
        panels.forEach((p) => {
          p.classList.remove('flex-[3.2]', 'active', 'bg-panel-bg');
          p.classList.add('flex-1', 'bg-panel-bg/25');
        });

        // Expand hovered panel
        panel.classList.remove('flex-1', 'bg-panel-bg/25');
        panel.classList.add('flex-[3.2]', 'active', 'bg-panel-bg');
      });
    });
  }

  document.addEventListener('astro:page-load', initIndustries);
</script>
