---
---
<section class="relative w-full min-h-[640px] md:min-h-[760px] flex items-center overflow-hidden bg-page-bg">
  <!-- Glowing Animated Radial Blobs -->
  <div class="absolute w-[640px] h-[640px] left-[-160px] top-[-160px] rounded-full animate-float-blob pointer-events-none" style="background: oklch(0.62 0.24 29 / 0.35); filter: blur(110px);"></div>
  <div class="absolute w-[560px] h-[560px] right-[-120px] bottom-[-180px] rounded-full animate-float-blob-reverse pointer-events-none" style="background: oklch(0.8 0.17 70 / 0.28); filter: blur(120px);"></div>

  <!-- Grid-line Overlay -->
  <div 
    class="absolute inset-0 bg-[linear-gradient(oklch(1_0_0_/_0.04)_1px,transparent_1px),linear-gradient(90deg,oklch(1_0_0_/_0.04)_1px,transparent_1px)] bg-[size:64px_64px] pointer-events-none"
    style="-webkit-mask-image: radial-gradient(circle at 30% 40%, black, transparent 75%); mask-image: radial-gradient(circle at 30% 40%, black, transparent 75%);"
  ></div>

  <!-- Hero Content -->
  <div class="relative z-10 px-6 md:px-20 max-w-5xl w-full pt-20">
    <!-- Eyebrow Pill -->
    <div 
      class="inline-flex items-center gap-2 px-4 py-2 border border-border-hairline mb-8 bg-panel-bg/40 backdrop-blur-sm animate-hero-up"
      style="animation-delay: 0s;"
    >
      <div class="w-2 h-2 rounded-full bg-accent-gold animate-pulse"></div>
      <span class="text-xs font-semibold tracking-[0.25em] uppercase text-text-muted">YOUR TRUSTED STEEL SUPPLY PARTNER</span>
    </div>

    <!-- Main Headline -->
    <h1 
      class="font-display font-extrabold text-4xl md:text-7xl leading-[1.08] tracking-tighter mb-8 animate-hero-up"
      style="animation-delay: 0.1s;"
    >
      Strength in steel.<br/>
      <span style="background: linear-gradient(95deg, oklch(0.62 0.24 29), oklch(0.8 0.17 70)); -webkit-background-clip: text; background-clip: text; color: transparent;">Delivered on time.</span>
    </h1>

    <!-- Supporting Copy -->
    <p 
      class="text-base md:text-xl leading-relaxed text-text-muted max-w-2xl mb-12 animate-hero-up"
      style="animation-delay: 0.2s;"
    >
      Ashapura Enterprise is Ahmedabad's premier stockiest and dealer of premium mild steel and re-rolling products. We power your construction, engineering, and fabrication projects with structural integrity.
    </p>

    <!-- CTAs -->
    <div 
      class="flex flex-wrap gap-4 animate-hero-up"
      style="animation-delay: 0.3s;"
    >
      <a 
        href="#products" 
        class="px-6 py-3.5 md:px-8 md:py-4.5 bg-text-primary text-page-bg font-bold text-sm hover:bg-accent-gold hover:text-page-bg transition-all duration-300 shadow-lg shadow-black/35 active:scale-98"
        style="border-radius: var(--btn-radius, 10px);"
      >
        Explore Products &rarr;
      </a>
      <a 
        href="#contact" 
        class="px-6 py-3.5 md:px-8 md:py-4.5 border border-border-hairline text-text-primary font-semibold text-sm hover:border-text-primary transition-all duration-300 active:scale-98"
        style="border-radius: var(--btn-radius, 10px);"
      >
        Request a Quote
      </a>
    </div>
  </div>
</section>
