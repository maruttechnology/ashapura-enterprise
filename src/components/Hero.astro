---
---

<section class="relative w-full min-h-[580px] md:min-h-screen md:h-screen flex items-center overflow-hidden bg-page-bg pt-20 pb-8 md:pt-24 md:pb-12">
  <!-- Warm Forge Molten Glow (Right Side) -->
  <div 
    class="absolute w-[680px] h-[680px] right-[-140px] top-1/2 -translate-y-1/2 rounded-full pointer-events-none opacity-60 blur-[130px]"
    style="background: radial-gradient(circle, rgba(242, 92, 5, 0.35) 0%, rgba(255, 183, 3, 0.15) 50%, transparent 70%);"
  ></div>

  <!-- Subtle Carbon Industrial Grid Overlay -->
  <div 
    class="absolute inset-0 bg-[linear-gradient(rgba(248,250,252,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(248,250,252,0.03)_1px,transparent_1px)] bg-[size:48px_48px] pointer-events-none"
    style="-webkit-mask-image: radial-gradient(circle at 25% 50%, black 20%, transparent 80%); mask-image: radial-gradient(circle at 25% 50%, black 20%, transparent 80%);"
  ></div>

  <!-- Hero Content -->
  <div class="relative z-10 px-6 md:px-14 max-w-7xl mx-auto w-full flex flex-col justify-between h-full">
    
    <div class="max-w-4xl">
      <!-- Eyebrow Pill -->
      <div 
        class="inline-flex items-center gap-2.5 px-3.5 py-1.5 border border-accent-vermillion/40 mb-8 bg-panel-bg/80 backdrop-blur-md animate-hero-up"
        style="animation-delay: 0s; border-radius: 4px;"
      >
        <div class="w-2 h-2 rounded-full bg-accent-gold animate-pulse"></div>
        <span class="text-[11px] font-mono font-bold tracking-widest uppercase text-accent-gold">
          YOUR TRUSTED STEEL SUPPLY PARTNER
        </span>
      </div>

      <!-- Heavy Display Main Headline -->
      <h1 
        class="font-display font-extrabold tracking-normal text-4xl sm:text-5xl md:text-6xl lg:text-6xl xl:text-7xl leading-[1.08] mb-6 animate-hero-up text-text-primary"
        style="animation-delay: 0.1s;"
      >
        Strength in steel.<br/>
        <span style="background: linear-gradient(95deg, oklch(0.62 0.24 29), oklch(0.8 0.17 70)); -webkit-background-clip: text; background-clip: text; color: transparent;">
          Delivered on time.
        </span>
      </h1>

      <!-- Supporting Copy -->
      <p 
        class="text-base md:text-lg leading-relaxed text-text-muted max-w-2xl mb-10 animate-hero-up"
        style="animation-delay: 0.2s;"
      >
        Ashapura Enterprise powers Gujarat's construction, engineering, and fabrication projects with certified mild steel angles, channels, pipes, bright bars, and custom re-rolled structural sections at direct wholesale rates.
      </p>

      <!-- CTAs & Action Buttons -->
      <div 
        class="flex flex-wrap items-center gap-4 animate-hero-up mb-10"
        style="animation-delay: 0.3s;"
      >
        <a 
          href="#products" 
          class="px-7 py-4 bg-accent-vermillion text-white font-bold text-sm tracking-wide uppercase hover:bg-opacity-90 transition-all duration-300 shadow-lg shadow-accent-vermillion/20 active:scale-98"
          style="border-radius: 6px;"
        >
          Explore Steel Catalog &rarr;
        </a>
        <a 
          href="#contact" 
          class="px-7 py-4 border border-border-hairline text-text-primary font-semibold text-sm tracking-wide uppercase hover:border-accent-gold hover:text-accent-gold transition-all duration-300 active:scale-98 bg-panel-bg/40"
          style="border-radius: 6px;"
        >
          Contact Godown
        </a>
      </div>

      <!-- Trust Pillars Badges -->
      <div class="flex flex-wrap items-center gap-6 pt-6 border-t border-border-hairline/60 text-xs font-mono text-text-secondary uppercase tracking-wider">
        <div class="flex items-center gap-2">
          <span class="text-accent-vermillion">✔</span> 100% Mill Test Certified
        </div>
        <div class="flex items-center gap-2">
          <span class="text-accent-vermillion">✔</span> Direct Wholesale Rates
        </div>
        <div class="flex items-center gap-2">
          <span class="text-accent-vermillion">✔</span> Instant Godown Loading
        </div>
      </div>
    </div>

  </div>
</section>
