---
---

<section class="relative w-full min-h-[640px] md:min-h-[760px] flex items-center overflow-hidden bg-[linear-gradient(120deg,oklch(0.99_0.003_95)_0%,oklch(0.97_0.012_195)_55%,oklch(0.94_0.02_195)_100%)] pt-24 pb-12 md:pt-28 md:pb-16">
  <!-- Hero Pipe Illustration (Right Side - Shifted Up on Mobile Only) -->
  <div class="absolute right-4 md:right-12 lg:right-20 top-[45%] md:top-1/2 -translate-y-1/2 w-[280px] sm:w-[340px] md:w-[400px] h-[360px] z-1 pointer-events-none opacity-40 md:opacity-100 transition-all duration-300">
    <svg viewBox="0 0 400 360" width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg">
      <ellipse cx="200" cy="315" rx="175" ry="24" fill="#2B2E38" opacity="0.08"></ellipse>
      <circle cx="130" cy="225" r="68" stroke="#2B2E38" stroke-width="2" opacity="0.55"></circle>
      <circle cx="130" cy="225" r="46" stroke="#2B2E38" stroke-width="1.5" opacity="0.4"></circle>
      <circle cx="270" cy="225" r="68" stroke="#4C8B8C" stroke-width="2" opacity="0.7"></circle>
      <circle cx="270" cy="225" r="46" stroke="#4C8B8C" stroke-width="1.5" opacity="0.55"></circle>
      <circle cx="200" cy="108" r="68" fill="#D9531E"></circle>
      <circle cx="200" cy="108" r="46" fill="#FDFCFB"></circle>
      <circle cx="200" cy="108" r="46" stroke="#D9531E" stroke-width="1.5"></circle>
    </svg>
  </div>

  <!-- Hero Content -->
  <div class="relative z-10 px-6 md:px-14 lg:px-20 max-w-7xl mx-auto w-full flex flex-col justify-between">
    
    <div class="max-w-3xl">
      <!-- Eyebrow Pill -->
      <div 
        class="inline-flex items-center gap-2 px-4 py-2 border border-[oklch(0.8_0.012_240)] mb-7 bg-white/60 backdrop-blur-sm animate-hero-up rounded-[6px]"
        style="animation-delay: 0s;"
      >
        <div class="w-2 h-2 rounded-full bg-[oklch(0.52_0.07_240)] animate-pulse"></div>
        <span class="text-[11px] sm:text-xs font-mono font-semibold tracking-[1.5px] uppercase text-[oklch(0.45_0.02_250)]">
          YOUR TRUSTED STEEL SUPPLY PARTNER
        </span>
      </div>

      <!-- Heavy Display Main Headline -->
      <h1 
        class="font-display font-bold tracking-tight text-4xl sm:text-5xl md:text-6xl lg:text-[60px] leading-[1.12] mb-7 animate-hero-up text-[oklch(0.22_0.03_250)]"
        style="animation-delay: 0.1s;"
      >
        Strength in steel.<br/>
        <span class="bg-[linear-gradient(95deg,oklch(0.62_0.19_35),oklch(0.52_0.07_240))] bg-clip-text text-transparent">
          Delivered on time.
        </span>
      </h1>

      <!-- Supporting Copy -->
      <p 
        class="text-base sm:text-lg md:text-[19px] leading-[1.6] text-[oklch(0.42_0.02_250)] max-w-2xl mb-10 animate-hero-up"
        style="animation-delay: 0.2s;"
      >
        Ashapura Enterprise powers Gujarat's construction, engineering, and fabrication projects with certified mild steel angles, channels, pipes, bright bars, and custom re-rolled structural sections at direct wholesale rates.
      </p>

      <!-- CTAs & Action Buttons -->
      <div 
        class="flex flex-wrap items-center gap-4 animate-hero-up mb-10"
        style="animation-delay: 0.3s;"
      >
        <a 
          href="#products" 
          class="px-8 py-4 bg-[oklch(0.62_0.19_35)] hover:bg-[oklch(0.54_0.19_33)] text-white font-bold text-sm sm:text-[15px] tracking-wide uppercase transition-all duration-300 shadow-md shadow-[oklch(0.62_0.19_35)]/20 active:scale-98 rounded-[6px]"
        >
          Explore Product &rarr;
        </a>
        <a 
          href="#contact" 
          class="px-8 py-4 border border-[oklch(0.72_0.015_240)] hover:border-[oklch(0.22_0.03_250)] text-[oklch(0.22_0.03_250)] font-semibold text-sm sm:text-[15px] tracking-wide uppercase transition-all duration-300 active:scale-98 bg-white/40 rounded-[6px]"
        >
          Contact Godown
        </a>
      </div>

      <!-- Trust Pillars Badges -->
      <div class="flex flex-wrap items-center gap-6 pt-6 border-t border-[oklch(0.85_0.012_240)] text-xs font-mono text-[oklch(0.42_0.02_250)] uppercase tracking-wider">
        <div class="flex items-center gap-2">
          <span class="text-[oklch(0.62_0.19_35)] font-bold">✔</span> 100% Mill Test Certified
        </div>
        <div class="flex items-center gap-2">
          <span class="text-[oklch(0.62_0.19_35)] font-bold">✔</span> Direct Wholesale Rates
        </div>
        <div class="flex items-center gap-2">
          <span class="text-[oklch(0.62_0.19_35)] font-bold">✔</span> Instant Godown Loading
        </div>
      </div>
    </div>

  </div>
</section>

