---
import { Image } from 'astro:assets';
import { godownWideShot } from '../assets/stock';
---

<section class="relative w-full min-h-[640px] md:min-h-[760px] flex items-center overflow-hidden bg-[linear-gradient(120deg,oklch(0.99_0.003_95)_0%,oklch(0.97_0.012_195)_55%,oklch(0.94_0.02_195)_100%)] pt-24 pb-12 md:pt-28 md:pb-16">
  <!-- Hero Full-Bleed Background Photo (desktop only) -->
  <div class="hidden md:block absolute inset-0 z-0">
    <Image
      src={godownWideShot}
      alt="Ashapura Enterprise godown stocked with steel angles, channels, and structural sections"
      class="w-full h-full object-cover object-right"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      widths={[960, 1440, 1920]}
      sizes="100vw"
    />
    <!-- Left-to-right readability gradient: opaque over the text, fades away so the photo reads clearly on the right -->
    <div class="absolute inset-0 bg-[linear-gradient(90deg,oklch(0.99_0.003_95)_0%,oklch(0.99_0.003_95)_32%,oklch(0.97_0.012_195_/_0.75)_48%,transparent_78%)]"></div>
  </div>

  <!-- Hero Content -->
  <div class="relative z-10 px-6 md:px-14 lg:px-20 max-w-7xl mx-auto w-full flex flex-col justify-between">
    
    <div class="max-w-3xl">
      <!-- Eyebrow Pill -->
      <div 
        class="inline-flex items-center gap-2 px-4 py-2 border border-[oklch(0.8_0.012_240)] mb-7 bg-white/60 backdrop-blur-sm animate-hero-up rounded-[6px]"
        style="animation-delay: 0s;"
      >
        <div class="w-2 h-2 rounded-full bg-[oklch(0.52_0.07_240)] animate-pulse"></div>
        <span class="text-[11px] sm:text-xs font-mono font-semibold tracking-[1.5px] uppercase text-[oklch(0.45_0.02_250)]">
          YOUR TRUSTED STEEL SUPPLY PARTNER
        </span>
      </div>

      <!-- Heavy Display Main Headline -->
      <h1 
        class="font-display font-bold tracking-tight text-4xl sm:text-5xl md:text-6xl lg:text-[60px] leading-[1.12] mb-7 animate-hero-up text-[oklch(0.22_0.03_250)]"
        style="animation-delay: 0.1s;"
      >
        Premium Steel.<br/>
        Wide Range.<br/>
        <span class="bg-[linear-gradient(95deg,oklch(0.62_0.19_35),oklch(0.52_0.07_240))] bg-clip-text text-transparent">
          Delivered on time.
        </span>
      </h1>

      <!-- Supporting Copy -->
      <p 
        class="text-base sm:text-lg md:text-[19px] leading-[1.6] text-[oklch(0.42_0.02_250)] max-w-2xl mb-10 animate-hero-up"
        style="animation-delay: 0.2s;"
      >
        Ashapura Enterprise powers Gujarat's construction, engineering, and fabrication projects with certified mild steel angles, channels, pipes, bright bars, and custom re-rolled structural sections at competitive prices.
      </p>

      <!-- Hero Product Photo (mobile only - normal document flow) -->
      <div class="md:hidden w-full aspect-[4/3] mb-10 rounded-2xl overflow-hidden shadow-xl ring-1 ring-white/40 animate-hero-up" style="animation-delay: 0.15s;">
        <Image
          src={godownWideShot}
          alt="Ashapura Enterprise godown stocked with steel angles, channels, and structural sections"
          class="w-full h-full object-cover object-right"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          widths={[400, 800]}
          sizes="100vw"
        />
      </div>

      <!-- CTAs & Action Buttons -->
      <div 
        class="flex flex-wrap items-center gap-4 animate-hero-up mb-10"
        style="animation-delay: 0.3s;"
      >
        <a 
          href="#products" 
          class="px-8 py-4 bg-[oklch(0.62_0.19_35)] hover:bg-[oklch(0.54_0.19_33)] text-white font-bold text-sm sm:text-[15px] tracking-wide uppercase transition-all duration-300 shadow-md shadow-[oklch(0.62_0.19_35)]/20 active:scale-98 rounded-[6px]"
        >
          Explore Products &rarr;
        </a>
        <a
          href="tel:+919825031940"
          class="inline-flex items-center gap-2 px-8 py-4 border border-[oklch(0.72_0.015_240)] hover:border-[oklch(0.22_0.03_250)] text-[oklch(0.22_0.03_250)] font-semibold text-sm sm:text-[15px] tracking-wide uppercase transition-all duration-300 active:scale-98 bg-white/40 rounded-[6px]"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          Call Us
        </a>
      </div>

      <!-- Trust Pillars Badges -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-6 border-t border-[oklch(0.85_0.012_240)]">
        <div class="flex items-center gap-3 px-3 py-2.5 rounded-[6px] border border-[oklch(0.88_0.012_240)] bg-white/50 backdrop-blur-sm">
          <span class="flex-shrink-0 w-6 h-6 rounded-full bg-[oklch(0.62_0.19_35)]/10 text-[oklch(0.62_0.19_35)] flex items-center justify-center">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </span>
          <span class="text-xs font-mono text-[oklch(0.42_0.02_250)] uppercase tracking-wider">100% Mill Test Certified</span>
        </div>
        <div class="flex items-center gap-3 px-3 py-2.5 rounded-[6px] border border-[oklch(0.88_0.012_240)] bg-white/50 backdrop-blur-sm">
          <span class="flex-shrink-0 w-6 h-6 rounded-full bg-[oklch(0.62_0.19_35)]/10 text-[oklch(0.62_0.19_35)] flex items-center justify-center">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </span>
          <span class="text-xs font-mono text-[oklch(0.42_0.02_250)] uppercase tracking-wider">Competitive Price</span>
        </div>
        <div class="flex items-center gap-3 px-3 py-2.5 rounded-[6px] border border-[oklch(0.88_0.012_240)] bg-white/50 backdrop-blur-sm">
          <span class="flex-shrink-0 w-6 h-6 rounded-full bg-[oklch(0.62_0.19_35)]/10 text-[oklch(0.62_0.19_35)] flex items-center justify-center">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </span>
          <span class="text-xs font-mono text-[oklch(0.42_0.02_250)] uppercase tracking-wider">Instant Godown Loading</span>
        </div>
      </div>
    </div>

  </div>
</section>

