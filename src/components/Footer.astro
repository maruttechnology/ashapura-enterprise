---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
const currentYear = new Date().getFullYear();
---
<footer class="bg-[oklch(0.99_0.003_95)]">
  <!-- Gradient Bottom Bar -->
  <div class="px-6 md:px-14 lg:px-[80px] py-8 border-t border-[oklch(0.85_0.012_240)] bg-[linear-gradient(120deg,oklch(0.99_0.003_95)_0%,oklch(0.97_0.012_195)_55%,oklch(0.94_0.02_195)_100%)] flex flex-col sm:flex-row justify-between items-center gap-4">
    <div class="flex items-center gap-2.5">
      <Image src={logo} alt="" class="h-8 w-auto" widths={[160, 320]} sizes="160px" />
      <span class="font-display font-bold text-xl tracking-tighter text-[oklch(0.22_0.03_250)]">
        Ashapura Enterprise
      </span>
    </div>
    <div class="text-[13px] text-[oklch(0.22_0.03_250)]/80">
      &copy; {currentYear} Ashapura Enterprise. All rights reserved.
    </div>
    <div class="flex gap-5 text-[13px] font-medium text-[oklch(0.22_0.03_250)]">
      <a href="/#about" class="hover:underline">About</a>
      <a href="/#products" class="hover:underline">Products</a>
      <a href="/#industries" class="hover:underline">Industries</a>
      <a href="/#contact" class="hover:underline">Contact</a>
    </div>
  </div>
</footer>

