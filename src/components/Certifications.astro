---
const certs = ["ISO 9001:2015 Certified", "ASTM Standard Compliant", "CE Marked Sections", "Mill Test Reports Provided"];
---
<section id="quality" class="py-24 px-6 md:px-14 bg-inset-bg border-b border-border-hairline">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
    
    <!-- Left Column: Real Steel Quality Testing Photo -->
    <div class="order-2 lg:order-1 relative h-[380px] bg-panel-bg border border-border-hairline overflow-hidden group">
      <img 
        src="/istockphoto-646996026-1024x1024.jpg" 
        alt="Ashapura Enterprise Steel Testing & Quality Assurance" 
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-85"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-page-bg via-transparent to-transparent opacity-60"></div>
    </div>

    <!-- Right Column: Details & badges -->
    <div class="order-1 lg:order-2">
      <span class="text-xs font-bold tracking-[0.25em] uppercase text-accent-gold mb-4 block">QUALITY & COMMITMENT</span>
      <h2 class="font-display font-extrabold text-4xl md:text-5xl leading-tight tracking-tight mb-8">
        No compromise on standard specifications
      </h2>
      <p class="text-text-muted leading-relaxed mb-6 text-base md:text-lg">
        At Ashapura Enterprise, we ensure that all our structural steel and re-rolled products meet strict industry standards and tolerances. We are committed to delivering premium quality with total honesty and transparency.
      </p>
      <p class="text-text-muted leading-relaxed mb-10 text-base md:text-lg">
        We believe that building strong relationships is based on consistency. Every single batch is checked for chemical and physical specifications, and we supply full Mill Test Certificates with every load.
      </p>

      <!-- Badges -->
      <div class="flex flex-wrap gap-3">
        {certs.map(cert => (
          <span class="px-4 py-2 border border-accent-gold/30 bg-accent-gold/5 text-accent-gold text-xs font-semibold uppercase tracking-wider">
            {cert}
          </span>
        ))}
      </div>
    </div>

  </div>
</section>
