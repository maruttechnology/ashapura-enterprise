---
const certs = ["ISO 9001:2015 Certified", "ASTM Standard Compliant", "CE Marked Sections", "Mill Test Reports Provided"];
---
<section id="quality" class="py-20 md:py-[130px] px-6 md:px-14 lg:px-[80px] bg-[oklch(0.99_0.003_95)]">
  <div class="max-w-[1280px] mx-auto flex flex-col lg:flex-row gap-12 lg:gap-[72px] items-center">
    
    <!-- Left Column: Photo Frame with Stripe Texture -->
    <div class="flex-1 w-full order-2 lg:order-1">
      <div class="h-[340px] sm:h-[400px] relative bg-[oklch(0.965_0.008_240)] border border-[oklch(0.87_0.012_240)] flex items-center justify-center overflow-hidden">
        <div class="absolute inset-0 bg-[repeating-linear-gradient(60deg,oklch(0.92_0.012_240)_0px,oklch(0.92_0.012_240)_22px,transparent_22px,transparent_44px)]"></div>
        <img 
          src="/istockphoto-646996026-1024x1024.jpg" 
          alt="Ashapura Enterprise Steel Testing & Quality Assurance" 
          class="relative z-10 w-full h-full object-cover"
        />
      </div>
    </div>

    <!-- Right Column: Details & Badges -->
    <div class="flex-1 w-full order-1 lg:order-2">
      <span class="text-[13px] font-bold tracking-[2px] uppercase text-[oklch(0.52_0.07_240)] mb-[16px] block">
        QUALITY & COMMITMENT
      </span>
      
      <h2 class="font-display font-bold text-3xl sm:text-4xl md:text-[44px] leading-[1.1] tracking-[-1px] text-[oklch(0.22_0.03_250)] mb-[24px]">
        No compromise on standard specifications
      </h2>

      <p class="text-[16px] leading-[1.8] text-[oklch(0.42_0.02_250)] mb-[30px]">
        At Ashapura Enterprise, we ensure that all our structural steel and re-rolled products meet strict industry standards and tolerances. We are committed to delivering premium quality with total honesty and transparency. Every single batch is checked for chemical and physical specifications, and we supply full Mill Test Certificates with every load.
      </p>

      <!-- Badges -->
      <div class="flex flex-wrap gap-[14px]">
        {certs.map(cert => (
          <span class="px-[18px] py-[11px] border border-[oklch(0.72_0.015_240)] text-[oklch(0.3_0.02_250)] text-[13px] font-semibold">
            {cert}
          </span>
        ))}
      </div>
    </div>

  </div>
</section>

