      <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3 3.86 8.708a2.25 2.25 0 0 0 0 3.182l5.708 5.708a2.25 2.25 0 0 0 3.182 0l5.708-5.708a2.25 2.25 0 0 0 0-3.182L12.75 3a2.25 2.25 0 0 0-3.182 0Z" />
