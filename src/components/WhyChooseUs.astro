---

<section id="why" class="py-24 bg-[oklch(0.14_0.008_30)] border-b border-border-hairline overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 md:px-20">
    
    <!-- Title -->
    <div class="mb-16">
      <span class="text-xs font-bold tracking-[0.25em] uppercase text-accent-gold mb-4 block">WHY CHOOSE US</span>
      <h2 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight">
        Engineered for reliability
      </h2>
    </div>

    <!-- Accordion Rows Container -->
    <div id="why-rows-container" class="flex flex-col border-t border-border-hairline/60">
      {reasons.map((item, index) => {
        return (
          <div 
            class="why-row relative flex flex-col md:flex-row md:items-center justify-between gap-4 md:gap-8 border-b border-border-hairline/60 group cursor-pointer select-none overflow-hidden px-4 py-6 md:px-9 md:py-[26px]"
            data-index={index}
          >
            <!-- Mobile Top Header / Desktop Column 1 (Number + Title) -->
            <div class="flex items-center justify-between gap-4 w-full md:w-auto md:min-w-[320px] md:flex-[0_0_auto]">
              <div class="flex items-center gap-3 md:gap-8">
                <!-- Left: Number -->
                <div class="why-row-number font-display font-bold text-xs md:text-base text-text-muted min-w-[24px] md:min-w-[38px] transition-colors duration-400">
                  {item.number}
                </div>

                <!-- Title -->
                <h3 class="why-row-title font-display font-bold text-base md:text-2xl text-text-primary transition-all duration-400">
                  {item.title}
                </h3>
              </div>

              <!-- Icon on Mobile Only -->
              <div class="why-row-icon md:hidden text-text-muted/40 transition-all duration-400 pointer-events-none select-none w-5 h-5 flex-none">
                <Fragment set:html={item.icon} />
              </div>
            </div>

            <!-- Middle: Description -->
            <div class="w-full md:w-[400px] lg:w-[440px] md:flex-[0_0_auto] why-row-desc transition-all duration-400 opacity-100 pl-7 md:pl-0">
              <p class="text-xs md:text-sm text-text-muted leading-relaxed">
                {item.description}
              </p>
            </div>

            <!-- Right: Icon on Desktop Only (Flex child on far right, no absolute overlap) -->
            <div class="why-row-icon hidden md:flex items-center justify-end text-text-muted/25 transition-all duration-400 pointer-events-none select-none w-10 h-10 flex-none">
              <Fragment set:html={item.icon} />
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>

<style>
  /* Row Base Transition */
  .why-row {
    transition: padding 0.45s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.4s ease, border-bottom-color 0.4s ease !important;
  }

  /* Temporary Sequential Pulse on Scroll */
  .why-row.mobile-pulse {
    border-bottom-color: oklch(0.62 0.24 29 / 0.5) !important;
  }
  .why-row.mobile-pulse .why-row-icon,
  .why-row.mobile-pulse .why-row-number {
    color: var(--color-accent-vermillion) !important;
    opacity: 1 !important;
  }
  .why-row.mobile-pulse .why-row-title {
    color: var(--color-accent-gold) !important;
  }

  /* Media Query for Desktop Interaction Logic */
  @media (min-width: 768px) {
    /* Solo Hovered State (Applied via JS on container hover active) */
    #why-rows-container.has-hovered .why-row {
      border-bottom-color: oklch(0.32 0.02 30 / 0.2);
    }

    /* When a row is the active hovered one */
    #why-rows-container.has-hovered .why-row.is-hovered {
      padding-top: 34px !important;
      padding-bottom: 34px !important;
    }
    
    #why-rows-container.has-hovered .why-row.is-hovered .why-row-title {
      color: var(--color-accent-gold) !important;
      font-size: 30px !important; /* 30px equivalent */
      font-weight: 700 !important;
    }

    #why-rows-container.has-hovered .why-row.is-hovered .why-row-number {
      color: var(--color-accent-vermillion) !important;
    }
    
    /* Icon hover transition and theme color matching */
    #why-rows-container.has-hovered .why-row.is-hovered .why-row-icon {
      color: var(--color-accent-vermillion) !important;
      opacity: 1 !important;
    }

    /* When other rows collapse around the hovered one */
    #why-rows-container.has-hovered .why-row:not(.is-hovered) {
      opacity: 0.3 !important;
    }
    #why-rows-container.has-hovered .why-row:not(.is-hovered) .why-row-title {
      font-size: 22px !important; /* 22px equivalent */
      color: var(--color-text-muted) !important;
    }

    #why-rows-container.has-hovered .why-row:not(.is-hovered) .why-row-desc {
      opacity: 0 !important;
      pointer-events: none !important;
    }
  }
</style>

<script>
  function initWhySection() {
    const container = document.getElementById('why-rows-container');
    const rows = document.querySelectorAll('.why-row');

    if (!container || rows.length === 0) return;

    // 1. Interactive Desktop Row Hover Handling
    rows.forEach((row) => {
      row.addEventListener('mouseenter', () => {
        container.classList.add('has-hovered');
        rows.forEach((r) => r.classList.remove('is-hovered'));
        row.classList.add('is-hovered');
      });
    });

    // Reset when leaving the entire section container
    container.addEventListener('mouseleave', () => {
      container.classList.remove('has-hovered');
      rows.forEach((r) => r.classList.remove('is-hovered'));
    });

    // 2. Sequential Cascade Highlight Animation on Scroll (Lightweight IntersectionObserver)
    let animated = false;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !animated) {
          animated = true;
          rows.forEach((row, i) => {
            setTimeout(() => {
              row.classList.add('mobile-pulse');
              setTimeout(() => {
                row.classList.remove('mobile-pulse');
              }, 450);
            }, i * 220);
          });
        }
      });
    }, { threshold: 0.25 });

    observer.observe(container);
  }

  document.addEventListener('astro:page-load', initWhySection);
</script>
