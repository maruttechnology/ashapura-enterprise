---
---
<section id="contact" class="py-20 md:py-[120px] px-6 md:px-14 lg:px-[80px] bg-[oklch(0.99_0.003_95)]">
  <div class="max-w-[1280px] mx-auto flex flex-col lg:flex-row gap-12 lg:gap-[72px]">
    
    <!-- Left Column: Contact Info -->
    <div class="flex-1 w-full">
      <span class="text-[13px] font-bold tracking-[2px] uppercase text-[oklch(0.52_0.07_240)] mb-[16px] block">
        GET IN TOUCH
      </span>
      <h2 class="font-display font-bold text-4xl md:text-[48px] tracking-[-1px] text-[oklch(0.22_0.03_250)] mb-[28px]">
        Let's build something solid
      </h2>
      
      <div class="flex flex-col gap-[18px]">
        <div class="text-[15px] text-[oklch(0.42_0.02_250)]">
          <span class="text-[oklch(0.22_0.03_250)] font-semibold">Office Address —</span> 32, Shyam Industrial Estate, Nr. Soni Ni Chali Cross Road, NH8, Odhav, Ahmedabad, Gujarat 382415
        </div>
        <div class="text-[15px] text-[oklch(0.42_0.02_250)]">
          <span class="text-[oklch(0.22_0.03_250)] font-semibold">Godown Address —</span> 51/1, GIDC Estate, B/h. Balaji Hotel, Nr. Fire Station, Odhav, Ahmedabad, Gujarat 382415
        </div>
        <div class="text-[15px] text-[oklch(0.42_0.02_250)]">
          <span class="text-[oklch(0.22_0.03_250)] font-semibold">Phone —</span> +91 96382 55045 / +91 98250 31940
        </div>
        <div class="text-[15px] text-[oklch(0.42_0.02_250)]">
          <span class="text-[oklch(0.22_0.03_250)] font-semibold">Email —</span> ashapuraenterprise02@gmail.com
        </div>
        <div class="text-[15px] text-[oklch(0.42_0.02_250)]">
          <span class="text-[oklch(0.22_0.03_250)] font-semibold">Hours —</span> Mon–Sat, 8:00 AM – 6:00 PM
        </div>
      </div>
    </div>

    <!-- Right Column: Form Container -->
    <div class="flex-1 w-full bg-[oklch(0.965_0.008_240)] border border-[oklch(0.87_0.012_240)] p-[38px]">
      <form class="flex flex-col gap-[16px]" onsubmit="event.preventDefault();">
        <input 
          type="text" 
          placeholder="Your Name" 
          class="p-[15px] bg-white border border-[oklch(0.82_0.012_240)] text-[oklch(0.22_0.03_250)] text-[14px] font-body focus:outline-none focus:border-[oklch(0.62_0.19_35)]" 
        />
        <input 
          type="email" 
          placeholder="Email Address" 
          class="p-[15px] bg-white border border-[oklch(0.82_0.012_240)] text-[oklch(0.22_0.03_250)] text-[14px] font-body focus:outline-none focus:border-[oklch(0.62_0.19_35)]" 
        />
        <input 
          type="tel" 
          placeholder="Phone Number" 
          class="p-[15px] bg-white border border-[oklch(0.82_0.012_240)] text-[oklch(0.22_0.03_250)] text-[14px] font-body focus:outline-none focus:border-[oklch(0.62_0.19_35)]" 
        />
        <textarea 
          placeholder="Tell us what you need..." 
          rows="4" 
          class="p-[15px] bg-white border border-[oklch(0.82_0.012_240)] text-[oklch(0.22_0.03_250)] text-[14px] font-body resize-none focus:outline-none focus:border-[oklch(0.62_0.19_35)]"
        ></textarea>
        <button 
          type="submit" 
          class="p-[16px] bg-[oklch(0.62_0.19_35)] hover:bg-[oklch(0.54_0.19_33)] text-white text-center font-bold text-[15px] tracking-[0.3px] rounded-[6px] transition-colors cursor-pointer"
        >
          Send Inquiry
        </button>
      </form>
    </div>

  </div>
</section>

