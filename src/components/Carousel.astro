---
import { getCollection } from 'astro:content';

const products = await getCollection('products');
const sortedProducts = products.sort((a, b) => a.data.order - b.data.order);
---

<section id="products" class="py-24 px-6 md:px-14 bg-inset-bg border-t border-b border-border-hairline">
  <div class="max-w-7xl mx-auto">
    <!-- Header with controls -->
    <div class="flex justify-between items-end mb-12">
      <div>
        <span class="text-xs font-bold tracking-[0.25em] uppercase text-accent-gold mb-4 block">OUR PRODUCTS</span>
        <h2 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight">Built for every application</h2>
      </div>
      <!-- Navigation arrows -->
      <div class="flex gap-3">
        <button 
          id="prev-btn" 
          class="cursor-pointer w-12 h-12 border border-border-hairline hover:bg-text-primary hover:text-page-bg transition-colors flex items-center justify-center font-bold text-lg select-none"
          aria-label="Previous products"
        >
          &larr;
        </button>
        <button 
          id="next-btn" 
          class="cursor-pointer w-12 h-12 border border-border-hairline hover:bg-text-primary hover:text-page-bg transition-colors flex items-center justify-center font-bold text-lg select-none"
          aria-label="Next products"
        >
          &rarr;
        </button>
      </div>
    </div>

    <!-- Product Slider Container -->
    <div 
      id="carousel-container" 
      class="overflow-hidden w-full relative cursor-grab active:cursor-grabbing select-none"
    >
      <div 
        id="carousel-track" 
        class="flex transition-transform duration-500 ease-[cubic-bezier(0.25,1,0.5,1)]"
        style="gap: 24px;"
      >
        {sortedProducts.map((product) => (
          <a 
            href={`/products/${product.id}`} 
            class="carousel-card flex-none w-[calc(100vw-48px)] md:w-[290px] bg-panel-bg border border-border-hairline p-6 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 hover:border-accent-vermillion group"
            data-astro-prefetch
          >
            <div>
              <!-- Product Image Placeholder -->
              <div class="relative w-full h-[180px] bg-page-bg border border-border-hairline flex items-center justify-center overflow-hidden mb-6">
                <!-- Diagonal stripes -->
                <div class="absolute inset-0 bg-[repeating-linear-gradient(45deg,oklch(0.26_0.014_30)_0px,oklch(0.26_0.014_30)_10px,transparent_10px,transparent_20px)] opacity-40"></div>
                <div class="relative text-[10px] font-mono text-text-secondary font-semibold uppercase tracking-wider text-center px-4">
                  {product.data.name} Photo
                </div>
              </div>

              <!-- Product Details -->
              <span class="text-[10px] font-bold uppercase tracking-wider text-accent-gold block mb-2">{product.data.category}</span>
              <h3 class="font-display font-bold text-xl text-text-primary mb-2 group-hover:text-accent-vermillion transition-colors">{product.data.name}</h3>
              <p class="text-xs text-text-muted leading-relaxed mb-6">{product.data.shortDescription}</p>
            </div>

            <!-- View details link -->
            <div class="text-xs font-bold text-accent-gold group-hover:text-accent-vermillion transition-colors flex items-center gap-1.5">
              View Details <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Dots Pagination Indicators -->
    <div id="carousel-dots" class="flex justify-center gap-2 mt-8">
      {sortedProducts.map((_, index) => (
        <button 
          class="carousel-dot w-2 h-2 rounded-full bg-border-hairline transition-all duration-300"
          data-index={index}
          aria-label={`Go to slide ${index + 1}`}
        ></button>
      ))}
    </div>
  </div>
</section>

<script>
  function initCarousel() {
    const container = document.getElementById('carousel-container');
    const track = document.getElementById('carousel-track');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const dots = document.querySelectorAll('.carousel-dot');
    const cards = document.querySelectorAll('.carousel-card');

    if (!container || !track || !prevBtn || !nextBtn || cards.length === 0) return;

    let currentIndex = 0;
    let autoplayInterval: number | undefined;
    let startX = 0;
    let isDragging = false;
    let currentTranslate = 0;
    let prevTranslate = 0;

    const gap = 24;

    function getSlideWidth() {
      const firstCard = cards[0] as HTMLElement;
      const cardWidth = firstCard ? firstCard.offsetWidth : 290;
      return cardWidth + gap;
    }

    // Compute maximum scroll limit based on screen width
    function getVisibleCount() {
      const containerWidth = container.offsetWidth;
      return Math.floor(containerWidth / getSlideWidth()) || 1;
    }

    function getMaxIndex() {
      const visibleCount = getVisibleCount();
      const maxIndex = cards.length - visibleCount;
      return maxIndex < 0 ? 0 : maxIndex;
    }

    function updateCarousel() {
      const maxIndex = getMaxIndex();
      
      // Keep index in boundary
      if (currentIndex > maxIndex) {
        currentIndex = 0; // wrap around
      } else if (currentIndex < 0) {
        currentIndex = maxIndex; // wrap to end
      }

      const slideWidth = getSlideWidth();
      currentTranslate = -currentIndex * slideWidth;
      track.style.transform = `translateX(${currentTranslate}px)`;
      prevTranslate = currentTranslate;

      // Update dots indicator active states
      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.classList.add('bg-accent-vermillion', 'w-4');
          dot.classList.remove('bg-border-hairline');
        } else {
          dot.classList.remove('bg-accent-vermillion', 'w-4');
          dot.classList.add('bg-border-hairline');
        }
      });
    }

    function nextSlide() {
      currentIndex++;
      updateCarousel();
    }

    function prevSlide() {
      currentIndex--;
      updateCarousel();
    }

    // Autoplay Controls
    function startAutoplay() {
      stopAutoplay();
      autoplayInterval = window.setInterval(nextSlide, 3500);
    }

    function stopAutoplay() {
      if (autoplayInterval) {
        clearInterval(autoplayInterval);
        autoplayInterval = undefined;
      }
    }

    // Touch and Drag Actions (Pointer events)
    container.addEventListener('pointerdown', (e) => {
      isDragging = true;
      startX = e.clientX;
      stopAutoplay();
      track.style.transition = 'none'; // Disable transition during drag
    });

    window.addEventListener('pointermove', (e) => {
      if (!isDragging) return;
      const currentX = e.clientX;
      const diff = currentX - startX;
      track.style.transform = `translateX(${prevTranslate + diff}px)`;
    });

    window.addEventListener('pointerup', (e) => {
      if (!isDragging) return;
      isDragging = false;
      track.style.transition = 'transform 0.5s cubic-bezier(0.25, 1, 0.5, 1)';
      
      const diff = e.clientX - startX;
      
      // Swipe threshold (50px)
      if (diff < -50) {
        nextSlide();
      } else if (diff > 50) {
        prevSlide();
      } else {
        updateCarousel(); // snap back if threshold not met
      }
      
      startAutoplay();
    });

    // Mouse hover pause/resume
    container.addEventListener('mouseenter', stopAutoplay);
    container.addEventListener('mouseleave', startAutoplay);

    // Button event listeners
    nextBtn.addEventListener('click', () => {
      nextSlide();
      startAutoplay();
    });

    prevBtn.addEventListener('click', () => {
      prevSlide();
      startAutoplay();
    });

    // Dot navigation
    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        const index = parseInt((e.target as HTMLElement).getAttribute('data-index') || '0');
        currentIndex = index;
        updateCarousel();
        startAutoplay();
      });
    });

    // Adjust slide translations on window resize
    window.addEventListener('resize', updateCarousel);

    // Initial run
    updateCarousel();
    startAutoplay();
  }

  // Load and reload on Page transitions
  document.addEventListener('astro:page-load', initCarousel);
</script>
