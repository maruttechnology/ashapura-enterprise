---
import { getCollection } from 'astro:content';

const products = await getCollection('products');
const sortedProducts = products.sort((a, b) => a.data.order - b.data.order);
// Duplicate products array 3 times for a seamless running banner marquee loop
const infiniteProducts = [...sortedProducts, ...sortedProducts, ...sortedProducts];

const stockImages = [
  '/istockphoto-518385254-1024x1024.jpg',
  '/istockphoto-537400206-1024x1024.jpg',
  '/istockphoto-638272110-1024x1024.jpg',
  '/istockphoto-646996026-1024x1024.jpg'
];
---

<section id="products" class="py-20 md:py-[120px] bg-[oklch(0.955_0.01_240)] overflow-hidden w-full">
  <!-- Section Header Container (Max Width Boxed) -->
  <div class="max-w-[1280px] mx-auto px-6 md:px-14 lg:px-[80px]">
    <div class="mb-10 text-center sm:text-left">
      <span class="text-[13px] font-bold tracking-[2px] uppercase text-[oklch(0.52_0.07_240)] mb-[12px] block">OUR PRODUCTS</span>
      <h2 class="font-display font-bold text-3xl sm:text-4xl md:text-[44px] tracking-[-1px] text-[oklch(0.22_0.03_250)]">Built for every application</h2>
    </div>
  </div>

  <!-- Full Screen Width Edge-to-Edge Running Banner -->
  <div class="relative w-full group/slider select-none">
    
    <!-- Left Glassmorphism Button Above Slider -->
    <button 
      id="prev-btn" 
      class="flex absolute left-4 sm:left-8 lg:left-12 top-1/2 -translate-y-1/2 z-40 cursor-pointer w-12 h-12 rounded-full bg-white/65 backdrop-blur-md border border-white/80 text-[oklch(0.22_0.03_250)] hover:bg-white/95 hover:text-[oklch(0.62_0.19_35)] hover:scale-105 transition-all items-center justify-center text-xl shadow-xl shadow-black/10 active:scale-95 select-none"
      aria-label="Previous products"
    >
      &#8592;
    </button>

    <!-- Right Glassmorphism Button Above Slider -->
    <button 
      id="next-btn" 
      class="flex absolute right-4 sm:right-8 lg:right-12 top-1/2 -translate-y-1/2 z-40 cursor-pointer w-12 h-12 rounded-full bg-white/65 backdrop-blur-md border border-white/80 text-[oklch(0.22_0.03_250)] hover:bg-white/95 hover:text-[oklch(0.62_0.19_35)] hover:scale-105 transition-all items-center justify-center text-xl shadow-xl shadow-black/10 active:scale-95 select-none"
      aria-label="Next products"
    >
      &#8594;
    </button>

    <!-- Edge-to-Edge 100vw Viewport -->
    <div id="carousel-viewport" class="overflow-hidden w-full relative touch-pan-y cursor-grab active:cursor-grabbing py-2">
      <div 
        id="carousel-track" 
        class="flex gap-6 will-change-transform"
      >
        {infiniteProducts.map((product, idx) => {
          const cardImg = stockImages[idx % stockImages.length];
          return (
            <a 
              href={`/products/${product.id}`} 
              class="carousel-card flex-none w-[270px] sm:w-[310px] bg-white border border-[oklch(0.87_0.012_240)] rounded-[18px] overflow-hidden flex flex-col justify-between shadow-xs transition-shadow"
              data-astro-prefetch
            >
              <div>
                <!-- Card Image Preview -->
                <div class="relative w-full h-[195px] bg-[oklch(0.965_0.008_240)] overflow-hidden">
                  <img 
                    src={cardImg} 
                    alt={product.data.name} 
                    class="w-full h-full object-cover"
                    draggable="false"
                  />
                  <!-- Category Pill -->
                  <div class="absolute top-3 left-3 z-20 px-3 py-1 bg-[oklch(0.22_0.03_250)]/85 text-white font-semibold text-[10px] tracking-wider uppercase rounded-full backdrop-blur-xs">
                    {product.data.category}
                  </div>
                </div>

                <!-- Product Details -->
                <div class="p-6">
                  <h3 class="font-display font-bold text-xl text-[oklch(0.22_0.03_250)] mb-2">
                    {product.data.name}
                  </h3>
                  <p class="text-xs text-[oklch(0.5_0.02_250)] leading-relaxed mb-4 line-clamp-2">
                    {product.data.shortDescription}
                  </p>
                  <div class="text-xs font-bold text-[oklch(0.62_0.19_35)] flex items-center gap-1.5">
                    View Details &rarr;
                  </div>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  function initCarousel() {
    const viewport = document.getElementById('carousel-viewport');
    const track = document.getElementById('carousel-track');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');

    if (!viewport || !track) return;

    const cards = track.querySelectorAll('.carousel-card');
    if (cards.length === 0) return;

    let position = 0;
    let speed = 0.6; // pixels per frame for continuous slow crawling
    let isPaused = false;
    let isDragging = false;
    let startX = 0;
    let startPosition = 0;
    let animationFrameId: number;

    const totalUniqueCards = cards.length / 3;
    
    function getCardStep() {
      const firstCard = cards[0] as HTMLElement;
      return firstCard ? firstCard.offsetWidth + 24 : 334;
    }

    function getOneSetWidth() {
      return totalUniqueCards * getCardStep();
    }

    function tick() {
      if (!isPaused && !isDragging) {
        position += speed;
        const setWidth = getOneSetWidth();
        
        // Loop endlessly when offset exceeds 1 set width
        if (position >= setWidth) {
          position -= setWidth;
        } else if (position < 0) {
          position += setWidth;
        }

        track.style.transform = `translateX(${-position}px)`;
      }
      animationFrameId = requestAnimationFrame(tick);
    }

    // Manual step scroll for left / right buttons
    function shiftBy(direction: number) {
      const step = getCardStep();
      const setWidth = getOneSetWidth();

      position += direction * step;

      if (position >= setWidth) {
        position -= setWidth;
      } else if (position < 0) {
        position += setWidth;
      }

      track.style.transition = 'transform 0.5s cubic-bezier(0.22, 1, 0.36, 1)';
      track.style.transform = `translateX(${-position}px)`;

      setTimeout(() => {
        track.style.transition = 'none';
      }, 500);
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => shiftBy(-1));
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => shiftBy(1));
    }

    // Pause on hover
    viewport.addEventListener('mouseenter', () => { isPaused = true; });
    viewport.addEventListener('mouseleave', () => { isPaused = false; });

    // Touch & Drag Handlers
    function onPointerDown(e: PointerEvent) {
      isDragging = true;
      startX = e.clientX;
      startPosition = position;
      track.style.transition = 'none';
    }

    function onPointerMove(e: PointerEvent) {
      if (!isDragging) return;
      const diff = e.clientX - startX;
      position = startPosition - diff;

      const setWidth = getOneSetWidth();
      if (position >= setWidth) position -= setWidth;
      if (position < 0) position += setWidth;

      track.style.transform = `translateX(${-position}px)`;
    }

    function onPointerUp() {
      isDragging = false;
    }

    viewport.addEventListener('pointerdown', onPointerDown);
    window.addEventListener('pointermove', onPointerMove);
    window.addEventListener('pointerup', onPointerUp);

    // Start running banner loop
    animationFrameId = requestAnimationFrame(tick);
  }

  document.addEventListener('astro:page-load', initCarousel);
</script>



