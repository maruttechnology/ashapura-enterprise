---
import { Image } from 'astro:assets';
import { godown } from '../assets/stock';
---
<section id="infrastructure" class="py-14 md:py-24 px-6 md:px-14 lg:px-[80px] bg-[oklch(0.955_0.01_240)]">
  <div class="max-w-[1280px] mx-auto">
    <div class="mb-[56px] text-center max-w-[640px] mx-auto">
      <span class="text-[13px] font-bold tracking-[2px] uppercase bg-[linear-gradient(95deg,oklch(0.62_0.19_35),oklch(0.52_0.07_240))] bg-clip-text text-transparent mb-[16px] block">INFRASTRUCTURE & FACILITIES</span>
      <h2 class="font-display font-bold text-3xl sm:text-4xl md:text-[44px] tracking-[-1px] text-[oklch(0.22_0.03_250)]">
        Built for capacity and speed
      </h2>
    </div>

    <!-- Single Facility Card (Office + Godown share one site) -->
    <div class="bg-[oklch(0.995_0.002_95)] border border-[oklch(0.87_0.012_240)] p-8 md:p-10 mb-12 group">
      <div class="grid md:grid-cols-2 gap-8 md:gap-10 items-center">
        <div>
          <div class="flex items-center gap-3 mb-6">
            <div class="w-8 h-8 rounded-full bg-[oklch(0.62_0.19_35)]/10 flex items-center justify-center text-[oklch(0.62_0.19_35)]">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
            </div>
            <h3 class="font-display font-bold text-2xl text-[oklch(0.22_0.03_250)]">Our Godown & Office</h3>
          </div>
          <p class="text-sm text-[oklch(0.42_0.02_250)] leading-relaxed mb-6">
            Our administrative office and storage godown operate from a single site in GIDC Odhav, Ahmedabad. Order processing, quotations, and dispatch coordination happen right alongside the stock itself, backed by heavy-duty gantry cranes, proper racking systems, and safe handling equipment, so queries and dispatch move faster with everything under one roof.
          </p>
        </div>

        <!-- Godown Photo -->
        <div class="relative h-[240px] md:h-[320px] bg-[oklch(0.965_0.008_240)] border border-[oklch(0.87_0.012_240)] rounded-2xl overflow-hidden">
          <Image
            src={godown}
            alt="Ashapura Enterprise godown storage area"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
            decoding="async"
            widths={[440, 880]}
            sizes="(min-width: 768px) 440px, 100vw"
          />
        </div>
      </div>
    </div>

    <!-- Operational Highlights -->
    <div class="grid grid-cols-3 gap-4 text-center">
      <div class="p-5 border border-[oklch(0.87_0.012_240)] bg-[oklch(0.995_0.002_95)]">
        <div class="text-[oklch(0.62_0.19_35)] font-display font-bold text-base md:text-lg mb-1">Large Inventory</div>
        <div class="text-[11px] uppercase tracking-wider text-[oklch(0.52_0.02_250)] font-semibold">High availability</div>
      </div>
      <div class="p-5 border border-[oklch(0.87_0.012_240)] bg-[oklch(0.995_0.002_95)]">
        <div class="text-[oklch(0.62_0.19_35)] font-display font-bold text-base md:text-lg mb-1">Safe Handling</div>
        <div class="text-[11px] uppercase tracking-wider text-[oklch(0.52_0.02_250)] font-semibold">Crane loading</div>
      </div>
      <div class="p-5 border border-[oklch(0.87_0.012_240)] bg-[oklch(0.995_0.002_95)]">
        <div class="text-[oklch(0.62_0.19_35)] font-display font-bold text-base md:text-lg mb-1">Quick Dispatch</div>
        <div class="text-[11px] uppercase tracking-wider text-[oklch(0.52_0.02_250)] font-semibold">Immediate transit</div>
      </div>
    </div>
  </div>
</section>

