---
---
<section id="infrastructure" class="py-24 px-6 md:px-14 max-w-7xl mx-auto w-full border-b border-border-hairline">
  <div class="mb-14 text-center">
    <span class="text-xs font-bold tracking-[0.25em] uppercase text-accent-gold mb-4 block">INFRASTRUCTURE & FACILITIES</span>
    <h2 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight">
      Built for capacity and speed
    </h2>
  </div>

  <!-- Office and Godown Cards -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16">
    <!-- Our Office -->
    <div class="bg-panel-bg border border-border-hairline p-8 flex flex-col justify-between group">
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-8 rounded-full bg-accent-gold/10 flex items-center justify-center text-accent-gold">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <h3 class="font-display font-bold text-2xl text-text-primary">Our Office</h3>
        </div>
        <p class="text-sm text-text-muted leading-relaxed mb-8">
          Our modern, well-equipped administrative office helps us manage operations efficiently, track order dispatch logs, and provide immediate quotations and response to customer queries.
        </p>
      </div>
      <!-- Image Slot -->
      <div class="relative h-[200px] bg-page-bg border border-border-hairline/60 flex items-center justify-center overflow-hidden">
        <div class="absolute inset-0 bg-[repeating-linear-gradient(-45deg,oklch(0.26_0.014_30)_0px,oklch(0.26_0.014_30)_12px,transparent_12px,transparent_24px)] opacity-35"></div>
        <span class="relative text-[10px] font-mono tracking-wider text-text-secondary uppercase select-none">[ ADMINISTRATIVE OFFICE PHOTO ]</span>
      </div>
    </div>

    <!-- Our Godown -->
    <div class="bg-panel-bg border border-border-hairline p-8 flex flex-col justify-between group">
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-8 rounded-full bg-accent-vermillion/10 flex items-center justify-center text-accent-vermillion">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
          </div>
          <h3 class="font-display font-bold text-2xl text-text-primary">Our Godown</h3>
        </div>
        <p class="text-sm text-text-muted leading-relaxed mb-8">
          Located strategically in GIDC Odhav, our spacious storage godown is equipped with heavy-duty gantry cranes, proper racking systems, and safe handling equipment for secure storage and dispatch.
        </p>
      </div>
      <!-- Image Slot -->
      <div class="relative h-[200px] bg-page-bg border border-border-hairline/60 flex items-center justify-center overflow-hidden">
        <div class="absolute inset-0 bg-[repeating-linear-gradient(-45deg,oklch(0.26_0.014_30)_0px,oklch(0.26_0.014_30)_12px,transparent_12px,transparent_24px)] opacity-35"></div>
        <span class="relative text-[10px] font-mono tracking-wider text-text-secondary uppercase select-none">[ STOCKYARD & STORAGE PHOTO ]</span>
      </div>
    </div>
  </div>

  <!-- Operational Highlights -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
    <div class="p-5 border border-border-hairline/60 bg-panel-bg/20">
      <div class="text-accent-gold font-display font-bold text-lg mb-1">Large Inventory</div>
      <div class="text-[10px] uppercase tracking-wider text-text-muted">High availability</div>
    </div>
    <div class="p-5 border border-border-hairline/60 bg-panel-bg/20">
      <div class="text-accent-gold font-display font-bold text-lg mb-1">Well Organized</div>
      <div class="text-[10px] uppercase tracking-wider text-text-muted">Racked storage</div>
    </div>
    <div class="p-5 border border-border-hairline/60 bg-panel-bg/20">
      <div class="text-accent-gold font-display font-bold text-lg mb-1">Safe Handling</div>
      <div class="text-[10px] uppercase tracking-wider text-text-muted">Crane loading</div>
    </div>
    <div class="p-5 border border-border-hairline/60 bg-panel-bg/20">
      <div class="text-accent-gold font-display font-bold text-lg mb-1">Quick Dispatch</div>
      <div class="text-[10px] uppercase tracking-wider text-text-muted">Immediate transit</div>
    </div>
  </div>
</section>
